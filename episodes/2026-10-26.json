 "repliques": [
  {
   "p": "presentateur",
   "t": "Ça y est, j'ai terminé Naruto.",
   "_deb": 0.0,
   "_fin": 1.46,
   "objet": "telephone"
  },
  {
   "p": "envoyee",
   "t": "Approche.",
   "_deb": 3.82,
   "_fin": 4.92
  },
  {
   "p": "envoyee",
   "t": "Parle. J'avais tout faux sur Itachi. Ne t'en fais pas.",
   "_deb": 6.08,
   "_fin": 9.1
  },
  {
   "p": "envoyee",
   "t": "Il a réussi à tous nous berner dans son illusion.",
   "_deb": 9.96,
   "_fin": 12.36
  },
  {
   "p": "envoyee",
   "t": "N'oublie pas qu'il en est le maître. C'est vrai.",
   "_deb": 13.28,
   "_fin": 15.22
  },
  {
   "p": "envoyee",
   "t": "Itachi est le maître absolu du Genjutsu. Ses illusions sont absolument époustouflantes.",
   "_deb": 15.24,
   "_fin": 20.54
  },
  {
   "p": "envoyee",
   "t": "Vas-y, exprime-toi, je sens que tu en as gros.",
   "_deb": 21.18,
   "_fin": 22.98
  },
  {
   "p": "envoyee",
   "t": "Roshimaru, Yerouzen, Danzo, Idan, Kabuto, je...",
   "_deb": 22.98,
   "_fin": 27.08
  },
  {
   "p": "envoyee",
   "t": "J'ai voulu leur faire du mal. À tous. Tu es encore jeune, mais ta réaction est légitime.",
   "_deb": 28.1,
   "_fin": 33.68
  },
  {
   "p": "envoyee",
   "t": "Tu n'as pas à t'en faire.",
   "_deb": 35.0,
   "_fin": 36.64
  },
  {
   "p": "envoyee",
   "t": "On l'a tous souhaité secrètement. Je sais. Vas-y, laisse venir.",
   "_deb": 37.78,
   "_fin": 41.62
  },
  {
   "p": "presentateur",
   "t": "Jiraiya me manque.",
   "_deb": 41.62,
   "_fin": 43.02
  },
  {
   "p": "envoyee",
   "t": "Tellement. Ah, Jiraiya. Il nous manque à tous. Ce personnage symbolise la figure paternelle de Naruto.",
   "_deb": 44.64,
   "_fin": 53.54,
   "objet": "livre"
  },
  {
   "p": "envoyee",
   "t": "Il est et restera une légende du monde shinobi, que ce soit dans ce monde ou dans l'au-delà.",
   "_deb": 54.38,
   "_fin": 60.68
  },
  {
   "p": "envoyee",
   "t": "Cette œuvre m'a appris tant de choses. Nomme-m'en une.",
   "_deb": 60.82,
   "_fin": 63.48
  },
  {
   "p": "envoyee",
   "t": "La persévérance. Sans la persévérance, Naruto n'aurait jamais réussi à amener Sasuke à la raison.",
   "_deb": 63.52,
   "_fin": 68.8
  },
  {
   "p": "presentateur",
   "t": "Jamais. C'est exact.",
   "_deb": 69.34,
   "_fin": 70.48
  },
  {
   "p": "envoyee",
   "t": "La persévérance est l'une des cordes névralgiques de notre monde.",
   "_deb": 71.06,
   "_fin": 74.22
  },
  {
   "p": "envoyee",
   "t": "Sans persévérance, il est impossible d'atteindre ses objectifs, quels qu'ils soient.",
   "_deb": 74.74,
   "_fin": 79.86
  },
  {
   "p": "envoyee",
   "t": "Le pardon, oui.",
   "_deb": 79.86,
   "_fin": 80.82
  },
  {
   "p": "envoyee",
   "t": "Accorder son pardon à une personne qui nous a fait du mal est la définition même de la grandeur d'âme.",
   "_deb": 81.84,
   "_fin": 86.04
  },
  {
   "p": "envoyee",
   "t": "C'est l'accomplissement de la vraie force. Je ne serai plus jamais le même désormais.",
   "_deb": 86.7,
   "_fin": 90.26
  },
  {
   "p": "envoyee",
   "t": "Je vois les choses plus clairement. Tu as bien grandi, mon frère.",
   "_deb": 91.6,
   "_fin": 94.4
  },
  {
   "p": "envoyee",
   "t": "Je suis fier de toi. J'en veux plus.",
   "_deb": 95.38,
   "_fin": 97.34
  },
  {
   "p": "envoyee",
   "t": "Conseille-moi une autre œuvre à regarder, je t'en supplie.",
   "_deb": 98.42,
   "_fin": 100.54
  },
  {
   "p": "envoyee",
   "t": "Je veux progresser. Très bien. Mais je te préviens, lorsque l 'on emprunte ce chemin,",
   "_deb": 102.3,
   "_fin": 108.08
  },
  {
   "p": "envoyee",
   "t": "il est impossible de faire marche arrière. Je suis prêt.",
   "_deb": 109.3,
   "_fin": 111.76
  },
  {
   "p": "envoyee",
   "t": "Très bien.",
   "_deb": 111.76,
   "_fin": 112.52,
   "objet": "tablette"
  },
  {
   "p": "envoyee",
   "t": "Alors découvre le chef -d 'œuvre de Togashi, Hunter x Hunter Hunter x Hunter?",
   "_deb": 113.42,
   "_fin": 118.48
  },
  {
   "p": "envoyee",
   "t": "Je te préviens",
   "_deb": 118.54,
   "_fin": 119.32
  },
  {
   "p": "envoyee",
   "t": "Tu ne sortiras pas indemne Merci grand frère Je saurais me montrer digne Va maintenant",
   "_deb": 121.04,
   "_fin": 125.56,
   "objet": "cadeau"
  },
  {
   "p": "envoyee",
   "t": "Et accomplis ton destin",
   "_deb": 127.12,
