 "repliques": [
  {
   "p": "envoyee",
   "t": "Papa, il y a une inconnue qui s'appelle Little Angel qui m'a proposé de monter dans sa voiture.",
   "_deb": 0.16,
   "_fin": 3.06
  },
  {
   "p": "envoyee",
   "t": "Je fais quoi?",
   "_deb": 3.1,
   "_fin": 3.42
  },
  {
   "p": "presentateur",
   "t": "Oh putain, fonce fiston, réfléchis pas. Monte dans cette voiture.",
   "_deb": 3.44,
   "_fin": 5.64
  },
  {
   "p": "envoyee",
   "t": "Tu m'as toujours dit de jamais parler aux inconnus et de surtout pas monter dans la voiture d'un inconnu.",
   "_deb": 5.7,
   "_fin": 8.86
  },
  {
   "p": "presentateur",
   "t": "Écoute-moi bien. Oublie tout ce que je t'ai dit jusqu'à présent.",
   "_deb": 8.88,
   "_fin": 10.94
  },
  {
   "p": "presentateur",
   "t": "Monte dans cette voiture.",
   "_deb": 11.08,
   "_fin": 12.02
  },
  {
   "p": "envoyee",
   "t": "J'ai l'impression que la dame est habillée en mère Noël, c'est assez joli.",
   "_deb": 12.1,
   "_fin": 14.04
  },
  {
   "p": "presentateur",
   "t": "Oh putain de bordel de merde. Mon fils, va avec la dame.",
   "_deb": 14.1,
   "_fin": 16.78
  },
  {
   "p": "presentateur",
   "t": "Tu te rappelles de la fée Clochette?",
   "_deb": 16.8,
   "_fin": 17.76
  },
  {
   "p": "envoyee",
   "t": "Oui.",
   "_deb": 17.78,
   "_fin": 17.98
  },
  {
   "p": "presentateur",
   "t": "Bah elle, c'est sa daronne. Donc va, va sans crainte.",
   "_deb": 18.0,
   "_fin": 20.1
  },
  {
   "p": "envoyee",
   "t": "Mais...",
   "_deb": 20.12,
   "_fin": 20.28
  },
  {
   "p": "presentateur",
   "t": "Va avec la dame, réfléchis pas, bordel.",
   "_deb": 20.38,
   "_fin": 21.76
  },
  {
   "p": "envoyee",
   "t": "Et si elle me fait des trucs bizarres?",
   "_deb": 21.78,
   "_fin": 22.74
  },
  {
   "p": "presentateur",
   "t": "Eh bah surtout, surtout, tu la laisses faire. Elle n'est pas comme les autres.",
   "_deb": 22.76,
   "_fin": 25.74
  },
  {
   "p": "presentateur",
   "t": "Elle exauce les vœux.",
   "_deb": 25.76,
   "_fin": 26.58
  },
  {
   "p": "envoyee",
   "t": "Mais si maman-",
   "_deb": 26.6,
   "_fin": 27.08
  },
  {
   "p": "presentateur",
   "t": "Maman n'en saura jamais rien. Donc arrête de discuter et monte dans cette putain de bagnole.",
   "_deb": 27.12,
   "_fin": 30.54
  },
  {
   "p": "presentateur",
   "t": "Tu te rends pas compte de ce qui est en train de t'arriver là, mon fils.",
   "_deb": 30.58,
   "_fin": 32.14
  },
  {
   "p": "presentateur",
   "t": "Je pourrais en chialer.",
   "_deb": 32.28,
   "_fin": 32.88
  },
  {
   "p": "envoyee",
   "t": "Je sais pas, si.",
   "_deb": 32.96,
   "_fin": 33.5
  },
  {
   "p": "presentateur",
   "t": "Bon écoute-moi maintenant. Dans la vie, il y a ceux qui gagnent au loto, il y a ceux qui touchent un héritage d'une grande tante inconnue et qui",
   "_deb": 33.54,
   "_fin": 37.12
  },
  {
   "p": "presentateur",
   "t": "se barrent vivre aux Bahamas. Et il y a ceux qui croisent Little Angel sur le parking du Leclerc.",
   "_deb": 37.14,
   "_fin": 40.26
  },
  {
   "p": "envoyee",
   "t": "Je comprends pas, papa.",
   "_deb": 40.34,
   "_fin": 41.12
  },
  {
   "p": "presentateur",
   "t": "Si tu ne montes pas dans cette voiture, crois-moi que tu t'en voudras toute ta vie.",
   "_deb": 41.18,
   "_fin": 44.22
  },
  {
   "p": "presentateur",
   "t": "Et je te parle d'une longue dépression, le genre de blessure qui se refermera jamais entièrement.",
   "_deb": 44.26,
   "_fin": 47.7
  },
  {
   "p": "presentateur",
   "t": "Aujourd'hui, ta vie va changer mon garçon. Donc, je t'en supplie, monte dans cette putain de bagnole.",
   "_deb": 47.96,
   "_fin": 52.36
  },
  {
   "p": "envoyee",
   "t": "Elle me fait signe de venir.",
   "_deb": 52.44,
   "_fin": 53.3
  },
  {
   "p": "presentateur",
   "t": "Little Angel, c'est quelqu'un de très bien. Tout le monde te le dira.",
   "_deb": 53.36,
   "_fin": 55.92
  },
  {
   "p": "presentateur",
   "t": "Enfin, surtout les daronnes. Mais ce que je veux dire, c'est que tu peux lui faire confiance.",
   "_deb": 55.96,
   "_fin": 58.48
  },
  {
   "p": "presentateur",
   "t": "C'est ta destinée, mon garçon.",
   "_deb": 59.06,
   "_fin": 60.4
  },
  {
   "p": "presentateur",
   "t": "Saisis-la.",
   "_deb": 61.38,
   "_fin": 61.82
  },
  {
   "p": "envoyee",
   "t": "Donc j'y vais?",
   "_deb": 61.86,
   "_fin": 62.22
  },
  {
   "p": "presentateur",
   "t": "Je t'en supplie.",
   "_deb": 62.26,
   "_fin": 62.82
  },
  {
   "p": "envoyee",
   "t": "Bon d'accord,",
   "_deb": 62.86,
   "_fin": 63.24
  },
  {
   "p": "envoyee",
   "t": "j'y vais.",
   "_deb": 64.22,
   "_fin": 64.54
  },
  {
   "p": "presentateur",
   "t": "Fiston, attends, je veux juste te dire une dernière chose.",
   "_deb": 64.58,
   "_fin": 66.26
  },
  {
   "p": "envoyee",
   "t": "Oui papa.",
   "_deb": 66.3,
   "_fin": 66.66
  },
  {
   "p": "presentateur",
   "t": "Avec maman, on est très fiers de toi, tu sais.",
   "_deb": 66.72,
   "_fin": 68.12
  },
  {
   "p": "envoyee",
   "t": "On le dira à maman?",
   "_deb": 68.16,
   "_fin": 68.72
  },
  {
   "p": "presentateur",
   "t": "On le dira jamais à maman. Elle nous couperait les couilles à tous les deux.",
   "_deb": 68.76,
   "_fin": 70.54
  },
  {
   "p": "envoyee",
   "t": "Pourquoi les couilles?",
   "_deb": 70.56,
   "_fin": 71.06
  },
  {
   "p": "presentateur",
   "t": "Va accomplir ton destin, mon fils. Tu y trouveras toutes les réponses à tes questions.",
