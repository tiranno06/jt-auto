   "_fin": 10.92,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Monte dans cette voiture.",
   "_deb": 11.06,
   "_fin": 12.04,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "J'ai l'impression que la dame est habillée en mère Noël, c'est assez joli.",
   "_deb": 12.1,
   "_fin": 14.04,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Oh putain de bordel de merde, mon fils. Va avec la dame.",
   "_deb": 14.1,
   "_fin": 16.78,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Tu te rappelles de la fée Clochette?",
   "_deb": 16.8,
   "_fin": 17.76,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Oui.",
   "_deb": 17.78,
   "_fin": 17.98,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Bah elle, c'est sa daronne. Donc va. Va sans crainte.",
   "_deb": 18.0,
   "_fin": 20.1,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Mais...",
   "_deb": 20.12,
   "_fin": 20.28,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Va avec la dame, réfléchis pas, bordel.",
   "_deb": 20.38,
   "_fin": 21.76,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Et si elle me fait des trucs bizarres?",
   "_deb": 21.78,
   "_fin": 22.74,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Eh bah surtout, surtout, tu la laisses faire. Elle n'est pas comme les autres.",
   "_deb": 22.78,
   "_fin": 25.74,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Elle exauce les vœux.",
   "_deb": 25.76,
   "_fin": 26.58,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Mais si maman-",
   "_deb": 26.62,
   "_fin": 27.08,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Maman n'en saura jamais rien. Donc arrête de discuter et monte dans cette putain de bagnole.",
   "_deb": 27.12,
   "_fin": 30.54,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Tu te rends pas compte de ce qui est en train de t'arriver là, mon fils.",
   "_deb": 30.58,
   "_fin": 32.14,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Je pourrais en chialer.",
