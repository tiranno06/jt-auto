   "_fin": 3.42,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Oh putain, fonce fiston, réfléchis pas. Monte dans cette voiture.",
   "_deb": 3.44,
   "_fin": 5.64,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Tu m'as toujours dit de jamais parler aux inconnus et de surtout pas monter dans la voiture d'un inconnu.",
   "_deb": 5.7,
   "_fin": 8.86,
   "objet": "telephone"
  },
  {
