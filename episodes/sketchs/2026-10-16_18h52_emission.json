   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Je t'en supplie, oui.",
   "_deb": 62.26,
   "_fin": 62.84,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Bon d'accord. J'y vais.",
