   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Avec maman, on est très fiers de toi, tu sais.",
   "_deb": 66.72,
   "_fin": 68.14,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "On le dira à maman?",
