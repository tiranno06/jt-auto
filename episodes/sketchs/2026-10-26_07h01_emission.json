   "_fin": 47.22
  },
  {
   "p": "invite",
   "t": "Aussi, oui.",
   "_deb": 47.36,
   "_fin": 47.92
  },
  {
   "p": "presentateur",
   "t": "Écoutez, c 'est incroyable. J 'ai une place qui vient de se libérer.",
   "_deb": 47.92,
   "_fin": 50.16
  },
  {
   "p": "presentateur",
   "t": "Si vous voulez, elle est à vous.",
   "_deb": 50.16,
   "_fin": 51.16
  },
  {
   "p": "invite",
   "t": "Merci.",
   "_deb": 51.44,
   "_fin": 52.36
  },
  {
