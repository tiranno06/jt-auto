 "repliques": [
  {
   "p": "presentateur",
   "t": "Esclaves, je t'affranchis, tu es un homme libre.",
   "_deb": 0.0,
   "_fin": 2.36,
   "objet": "billet"
  },
  {
   "p": "invite",
   "t": "Merci. Mais quoi, ça veut dire que je ne ramasserai plus le coton ?",
   "_deb": 2.46,
   "_fin": 5.76
  },
  {
   "p": "presentateur",
   "t": "Eh ben voilà, c'est terminé. Fini les limbagos.",
   "_deb": 5.8,
   "_fin": 7.84
  },
  {
   "p": "invite",
   "t": "C'est génial. Et je ne ferai plus le ménage non plus ?",
   "_deb": 7.86,
   "_fin": 10.28
  },
  {
   "p": "presentateur",
   "t": "Ben non, c'est fini, ça aussi.",
   "_deb": 10.34,
   "_fin": 11.48
  },
  {
   "p": "invite",
   "t": "C'est super, ça. Et je ne brosserai plus les chevaux.",
   "_deb": 11.52,
   "_fin": 13.58
  },
  {
   "p": "presentateur",
   "t": "Mais tu es libre, je te dis.",
   "_deb": 13.58,
   "_fin": 14.78
  },
  {
   "p": "invite",
   "t": "Ah, merci. Merci du fond du cœur, merci.",
   "_deb": 14.82,
   "_fin": 16.94
  },
  {
   "p": "presentateur",
   "t": "Qu'est-ce que vous allez faire maintenant ?",
   "_deb": 17.0,
   "_fin": 18.26
  },
  {
   "p": "invite",
   "t": "Ben, dormir un peu. Je suis épuisé, moi. Bon, je reverrai.",
   "_deb": 18.4,
   "_fin": 21.6
  },
  {
   "p": "invite",
   "t": "De toute façon, j'habite à côté.",
   "_deb": 21.6,
   "_fin": 22.66
  },
  {
   "p": "presentateur",
   "t": "Ah non, désolé, mais vous ne pouvez pas rester ici, hein.",
   "_deb": 22.74,
   "_fin": 24.88
  },
  {
   "p": "invite",
   "t": "Quoi ? Mais pourquoi ?",
   "_deb": 25.0,
   "_fin": 26.4
  },
  {
   "p": "presentateur",
   "t": "Ben parce que quand on est un homme libre, on s'achète une maison et on ne vit pas chez son voisin.",
   "_deb": 26.46,
   "_fin": 29.56
  },
  {
   "p": "presentateur",
   "t": "on s'assume.",
   "_deb": 29.42,
   "_fin": 30.28
  },
  {
   "p": "invite",
   "t": "Comment je peux me payer une maison ? J'ai pas d'argent.",
   "_deb": 30.28,
   "_fin": 32.22
  },
  {
   "p": "presentateur",
   "t": "Vous avez pas mis deux-trois sous de côté quand vous étiez chez moi ?",
   "_deb": 32.22,
   "_fin": 34.52
  },
  {
   "p": "invite",
   "t": "C'est-à-dire que j'ai pas vu une pièce de monnaie depuis que je suis arrivé d'Afrique.",
   "_deb": 34.52,
   "_fin": 37.34
  },
  {
   "p": "presentateur",
   "t": "Vous avez tout claqué, c'est ça ? Flambeur ! Bon, je vais pas vous laisser tomber.",
   "_deb": 37.36,
   "_fin": 42.38
  },
  {
   "p": "presentateur",
   "t": "Qu'est-ce que vous savez faire ? Vous savez ramasser le coton ?",
