 "repliques": [
  {
   "p": "presentateur",
   "t": "Je peux voir ton téléphone vite fait? Non.",
   "_deb": 0.0,
   "_fin": 1.58,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Pardon? Ah pardon, si, si, bien sûr, si, bien sûr.",
   "_deb": 1.74,
   "_fin": 3.86,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Bah tu me le passes? Non. Pourquoi tu veux pas que je regarde ton téléphone?",
   "_deb": 5.12,
   "_fin": 7.34,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Ah mais j'ai aucun problème avec le fait que tu regardes mon téléphone.",
   "_deb": 7.4,
   "_fin": 9.52,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Ça passe le moins alors? Je peux le faire pas.",
   "_deb": 9.54,
   "_fin": 10.68,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Tu me caches quelque chose ou quoi?",
   "_deb": 10.7,
   "_fin": 11.42,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Je te cache rien du tout, c'est juste que mon téléphone, c'est mon intimité.",
   "_deb": 11.54,
   "_fin": 14.64,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "C'est comme si, imagine un mec qui te croise dans la rue, il dit « Hey, monte-moi ta culotte! »",
   "_deb": 14.64,
   "_fin": 17.32,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Tu vas l'envoyer se faire foutre, on est d'accord?",
   "_deb": 17.32,
   "_fin": 19.0,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Bon bah voilà.",
   "_deb": 19.12,
   "_fin": 19.42,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Attends, donc là, t'es en train de me dire d'aller me faire foutre.",
   "_deb": 19.48,
   "_fin": 20.96,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Non mais pas toi! Ce que je veux dire, c'est que...",
   "_deb": 20.96,
   "_fin": 22.92,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Non, oui, je comprends que tu l'aies compris comme ça, mais c'est pas ce que je voulais dire.",
   "_deb": 23.08,
   "_fin": 25.32,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "En fait... Pourquoi tu veux pas que je regarde ton téléphone?",
   "_deb": 25.38,
   "_fin": 26.78,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Mais parce que si tout le monde regarde dans le téléphone de tout le monde, ça veut plus rien dire.",
   "_deb": 26.82,
   "_fin": 30.08,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Attends, mais c'est ce que t'es en train de dire là, qui veut rien dire.",
   "_deb": 30.14,
   "_fin": 31.7,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Ah, je suis pas d'accord. Moi, j'avais plutôt l'impression que ça suivait une certaine logique, non?",
   "_deb": 31.74,
   "_fin": 34.52,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Bon, ça y est, tu m'as saoulé. Montre-moi ton téléphone.",
   "_deb": 34.6,
   "_fin": 36.06,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Quel téléphone?",
   "_deb": 36.06,
   "_fin": 36.64,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Ah, parce que t'en as plusieurs?",
   "_deb": 36.7,
   "_fin": 37.62,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Pas du tout. Tu m'as pris pour Walter White ou quoi?",
   "_deb": 37.64,
   "_fin": 39.9,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Attends, te compare pas à Heisenberg. T'es rien à côté.",
   "_deb": 39.92,
   "_fin": 41.8,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Ah bon, c'était débile. Tu sais quoi?",
   "_deb": 41.8,
   "_fin": 42.74,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Tu veux jouer aux gamins? Garde-le ton téléphone.",
   "_deb": 42.74,
   "_fin": 44.44,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Ah, ben quand même. Merci.",
   "_deb": 44.46,
   "_fin": 45.9,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Je sors ce soir.",
   "_deb": 45.92,
   "_fin": 46.58,
   "objet": "billet"
  },
  {
   "p": "invite",
   "t": "Ah oui?",
   "_deb": 46.62,
   "_fin": 47.4,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Avec qui? Un mec.",
   "_deb": 47.4,
   "_fin": 48.32,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Un mec qui a quelqu'un avec des bras, des jambes et toute la panoplie?",
   "_deb": 48.34,
   "_fin": 51.22,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Un mec.",
   "_deb": 51.26,
   "_fin": 51.6,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Je le connais?",
   "_deb": 51.64,
   "_fin": 52.28,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Excuse-moi, je peux pas te répondre. C'est mon intimité.",
   "_deb": 52.3,
   "_fin": 53.88,
   "objet": "telephone"
  },
  {
   "p": "presentateur",
   "t": "Tu comprends?",
   "_deb": 53.88,
   "_fin": 54.32,
   "objet": "telephone"
  },
  {
   "p": "invite",
   "t": "Après ton intimité, tu peux la partager avec ton mec, c'est qui ce mec?",
